    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
